# --- Socle Peptide Partners (la boutique n'a pas de base de données) ---
PP_API_URL="https://dash.peptide-partners.io"   # sans slash final
PP_API_KEY="pp_xxxxxxxx_secret"                   # Paramètres → Clés d'API, affichée une seule fois
PP_MEDIA_HOSTS=""                                  # hôtes supplémentaires des visuels (S3 public), séparés par des virgules
PP_MOCK="1"                                        # 1 = docs/mock/catalogue.json, pas d'appel réseau

# --- Stripe (produit classique) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."                  # stripe listen --forward-to localhost:3002/api/stripe/webhook

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# --- Base propre à SCULT (commandes, stock, clients, admin) ---
# Renseignée : la boutique lit et écrit dans cette base, le socle et le catalogue de test ne servent plus.
# En ligne : l'adresse « pooled » de Neon. En local : npm run db:local, puis l'adresse ci-dessous.
DATABASE_URL="postgresql://scult:scult@localhost:54329/scult"
ADMIN_SESSION_SECRET=""                            # openssl rand -base64 36 (32 caractères au moins)
