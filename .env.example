# --- Socle Peptide Partners (la boutique n'a pas de base de données) ---
PP_API_URL="https://dash.peptide-partners.io"   # sans slash final
PP_API_KEY="pp_xxxxxxxx_secret"                   # Paramètres → Clés d'API, affichée une seule fois
PP_MEDIA_HOSTS=""                                  # hôtes supplémentaires des visuels (S3 public), séparés par des virgules
PP_MOCK="1"                                        # 1 = docs/mock/catalogue.json, pas d'appel réseau

# --- Stripe (produit classique) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."                  # stripe listen --forward-to localhost:3002/api/stripe/webhook

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# --- Base propre à SCULT (commandes, stock, clients, admin) ---
# Renseignée : la boutique lit et écrit dans cette base, le socle et le catalogue de test ne servent plus.
# En ligne : l'adresse « pooled » de Neon. En local : npm run db:local, puis l'adresse ci-dessous.
# ⚠ En local, mettre ces deux lignes dans .env.local, pas dans .env : `vercel --prod` embarque .env, et le build
#   irait chercher une base sur localhost. En ligne, elles se règlent dans les variables d'environnement de Vercel.
DATABASE_URL="postgresql://scult:scult@localhost:54329/scult"
ADMIN_SESSION_SECRET=""                            # openssl rand -base64 36 (32 caractères au moins)

# --- E-mails aux clients (Resend) : confirmation, expédition, annulation, remboursement ---
# Sans clé, aucun e-mail ne part ; les commandes fonctionnent quand même et l'admin le signale.
RESEND_API_KEY=""
EMAIL_FROM="SCULT <commandes@scult.eu>"            # sur un domaine vérifié chez Resend
EMAIL_REPLY_TO="hello@scult.eu"                    # où arrivent les réponses des clients
ORDERS_NOTIFY_EMAIL=""                             # facultatif : reçoit une alerte à chaque nouvelle commande

# --- Sendcloud : étiquettes et suivi (le compte de Peptide Partners, comme PTM) ---
SENDCLOUD_PUBLIC_KEY=""
SENDCLOUD_SECRET_KEY=""
SENDCLOUD_BRAND_ID=""                              # la marque SCULT créée dans Sendcloud (jamais celle du logisticien)
SENDCLOUD_SENDER_ADDRESS_ID=""                     # l'adresse d'expéditeur « PP – SCULT »
SENDCLOUD_WEBHOOK_SECRET=""                        # signe les signaux de suivi reçus sur /api/webhooks/sendcloud
CRON_SECRET=""                                     # protège /api/cron/suivi-colis (rattrapage du suivi, à appeler chaque heure)

# --- Référencement ---
SITE_INDEXABLE=""                                  # 1 sur le vrai domaine ; vide : un déploiement Vercel reste hors des moteurs
GOOGLE_SITE_VERIFICATION=""                        # jeton de Google Search Console (balise HTML)
BING_SITE_VERIFICATION=""                          # jeton de Bing Webmaster Tools
